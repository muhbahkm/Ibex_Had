{
  "expo": {
    "name": "IBEX HAD",
    "slug": "ibex-had",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "ibexhad",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ibexhad.mobile"
    },
    "android": {
      "package": "com.ibexhad.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#F7F7F5"
      },
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "السماح لـ IBEX HAD بحماية جلسة تسجيل الدخول على هذا الجهاز."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

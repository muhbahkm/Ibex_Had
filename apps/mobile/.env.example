EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Temporary visual-testing mode only. Never enable in production builds.
# When enabled, the app uses a local Manager Preview Persona and blocks real financial data calls.
EXPO_PUBLIC_AUTH_MODE=preview

# Optional local-only preview identity overrides. Never commit real personal identity data here.
# These values are presentation/testing inputs only and never grant production authorization.
EXPO_PUBLIC_PREVIEW_MANAGER_NAME=محمد باحكم
EXPO_PUBLIC_PREVIEW_MANAGER_PHONE=